{
  "version": 3,
  "configurePresets": [
    {
      "name": "full",
      "displayName": "Charging Platform",
      "binaryDir": "${sourceDir}/build/full",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "BUILD_USER_APP": "ON",
        "BUILD_ADMIN_APP": "ON",
        "BUILD_SERVER": "ON",
        "BUILD_MOBILE_FLOW_TESTS": "ON"
      }
    }
  ]
}
